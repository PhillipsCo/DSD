<UserControl x:Class="DSD.UI.Views.ApiListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DSD.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Update"
  Width="90"
  Margin="0,0,8,0"
  Command="{Binding ApiList.UpdateCommand}"/>

            <Button Content="Copy"
  Width="90"
  Margin="0,0,8,0"
  Command="{Binding ApiList.CopyCommand}"/>

            <Button Content="Delete"
  Width="90"
  Command="{Binding ApiList.DeleteCommand}"/>
        </StackPanel>

        <!-- Grid -->
        <DataGrid Grid.Row="1"
ItemsSource="{Binding ApiList.Items}"
SelectedItem="{Binding ApiList.SelectedItem, Mode=TwoWay}"
AutoGenerateColumns="False"
CanUserAddRows="True"
CanUserDeleteRows="False"
IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="TABLE_NAME" Binding="{Binding TABLE_NAME, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="API_NAME"   Binding="{Binding API_NAME,   UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="FILTER"     Binding="{Binding FILTER,     UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTextColumn Header="BATCHSIZE"     Binding="{Binding BATCHSIZE,     UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTextColumn Header="DIR"        Binding="{Binding DIR,        UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                <DataGridTextColumn Header="RUNGROUP"   Binding="{Binding RUNGROUP,   UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                <DataGridTextColumn Header="ENDPOINT"   Binding="{Binding ENDPOINT,   UpdateSourceTrigger=PropertyChanged}" Width="3*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
