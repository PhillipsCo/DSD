<UserControl x:Class="DSD.UI.Views.CustomerInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DSD.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Reload"
 Width="90"
 Margin="0,0,8,0"
 Command="{Binding CustomerInfo.ReloadCommand}" />

            <Button Content="Update"
 Width="90"
 Command="{Binding CustomerInfo.UpdateCommand}" />

            <!-- Busy indicator -->
            <TextBlock Margin="12,0,0,0"
    VerticalAlignment="Center"
    Text="Loading..."
    Visibility="{Binding CustomerInfo.IsBusy, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="12" Grid.IsSharedSizeScope="True">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,6,6"/>
                    </Style>

                    <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
                        <Setter Property="Width" Value="220"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                    </Style>
                </Grid.Resources>

                <!-- LEFT COLUMN -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Customer:"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.Customer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Url:"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Grant_Type:"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.Grant_Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Client_ID:"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.Client_ID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Client_Secret:"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.Client_Secret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Scope:"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.Scope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="RootUrl:"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.RootUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="ftpHost:"/>
                    <TextBox   Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.ftpHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="ftpUser:"/>
                    <TextBox   Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.ftpUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="ftpPass:"/>
                    <TextBox   Grid.Row="9" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.ftpPass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="ftpRemoteFilePath:"/>
                    <TextBox   Grid.Row="10" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.ftpRemoteFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="ftpLocalFilePath:"/>
                    <TextBox   Grid.Row="11" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.ftpLocalFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- RIGHT COLUMN -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="DataSource:"/>
                    <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.DataSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="UserID:"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.UserID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="Password:"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="InitialCatalog:"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.InitialCatalog, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="DayOffset:"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.DayOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="email_tenantId:"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.email_tenantId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="email_clientId:"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.email_clientId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="email_secret:"/>
                    <TextBox   Grid.Row="7" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.email_secret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="email_sender:"/>
                    <TextBox   Grid.Row="8" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.email_sender, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="email_recipient:"/>
                    <TextBox   Grid.Row="9" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.email_recipient, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="PROD:"/>
                    <CheckBox  Grid.Row="10" Grid.Column="1" Margin="0,0,0,6"
            IsChecked="{Binding CustomerInfo.Current.PROD, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            VerticalAlignment="Center" />

                    <TextBlock Grid.Row="11" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="HISTORY_DAYS:"/>
                    <TextBox   Grid.Row="11" Grid.Column="1" Style="{StaticResource FieldTextBoxStyle}"
            Text="{Binding CustomerInfo.Current.HISTORY_DAYS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, NotifyOnValidationError=True}" />
                </Grid>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
