<UserControl x:Class="DSD.UI.Views.RunAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DSD.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Grid.Row="1"
            Grid.Column="0"
            Width="300">

            <TextBlock TextWrapping="Wrap"
               FontSize="13"
               Margin="0,0,0,12">
        Choose the customer above that you would like to work with.
        Then choose the APP you would like to run. Outbound has two
        options: ALL tables or a specific table.
            </TextBlock>

            <TextBlock Text="DIRECTION"
               FontWeight="Bold"
               Margin="0,0,0,4"/>

            <ComboBox ItemsSource="{Binding Directions}"
              SelectedItem="{Binding SelectedDirection, Mode=TwoWay}"
              Width="280"
              Margin="0,0,0,12"/>


            <TextBlock FontWeight="Bold"
           Margin="0,12,0,4">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="TABLE / GROUP" />

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedDirection}" Value="ExportOneCsv">
                                <Setter Property="Text" Value="VIEW TO EXPORT" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>


            <!-- Inbound = ALL -->
            <TextBlock Text="ALL"
               FontSize="14"
               FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedDirection}" Value="Inbound">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Outbound table selector -->
            <ComboBox ItemsSource="{Binding TableOptions}"
              SelectedItem="{Binding SelectedTableOption, Mode=TwoWay}"
              Width="280"
              Margin="0,4,0,0">
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            
                            <DataTrigger Binding="{Binding SelectedDirection}" Value="Outbound">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>


                            <DataTrigger Binding="{Binding SelectedDirection}" Value="ExportOneCsv">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <TextBlock Text="SEND TO CIS"
               FontWeight="Bold"
               Margin="0,12,0,4"/>

            <CheckBox Content="Yes"
              IsChecked="{Binding SendToCis, Mode=TwoWay}"
              FontSize="14"/>

            <Button Content="Run"
            Command="{Binding RunCommand}"
            Width="120"
            Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
