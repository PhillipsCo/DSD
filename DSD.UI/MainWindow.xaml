<Window x:Class="DSD.UI.MainWindow"
        xmlns:views="clr-namespace:DSD.UI.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DSD"
        Height="700"
        Width="900"
        Icon="DSD.ico"
        Background="#76829a">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </Window.Resources>

        <Grid Margin="20">

        <!-- Layout definitions -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>-->

        <!-- HEADER -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Padding="12"
                Margin="0,0,0,16"
                CornerRadius="6"
                Background="#95A0B6">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Changed "\" to "/" for clarity/safety -->
                <TextBlock Text="CUSTOMER / ENVIRONMENT"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>

                <ComboBox ItemsSource="{Binding Customers}"
                          DisplayMemberPath="Customer"
                          SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                          Width="320"
                          FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- LEFT PANEL (Run controls) -->
        

        <!-- RIGHT PANEL (Tabs) -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="16,0,0,0"
                Padding="12"
                CornerRadius="6"
                Background="#95A0B6">

            <TabControl>
                <!-- NEW TAB 1: Schedule Log -->
                <TabItem Header="Schedule Log">
                    <views:DsdLogView />
                </TabItem>
                <!-- NEW TAB 2: Schedule Log -->
                <TabItem Header="Run Apps">
                    <views:RunAppView />
                </TabItem>
                <!-- TAB 3: Daily Schedule -->
                <TabItem Header="Daily Schedule">
                    <views:DailyScheduleView />
                </TabItem>

                <!-- TAB 4: API List -->
                <TabItem Header="API List">
                    <views:ApiListView />
                </TabItem>

                <TabItem Header="API Tester"
         x:Name="ApiTesterTab" />

                <!-- TAB 5: Customer Info -->
                <TabItem Header="Customer Info">
                    <views:CustomerInfoView />
                </TabItem>
                <!-- TAB 6: Load CISOUT -->
                <TabItem Header="Load Invoices from CIS">
                    <views:LoadCsvView />
                </TabItem>

            </TabControl>
        </Border>

    </Grid>
</Window>