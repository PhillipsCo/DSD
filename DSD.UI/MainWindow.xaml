<Window x:Class="DSD.UI.MainWindow"
        xmlns:views="clr-namespace:DSD.UI.Views"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DSD"
        Height="700"
        Width="1500"
        Background="#76829a">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </Window.Resources>

        <Grid Margin="20">

        <!-- Layout definitions -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Padding="12"
                Margin="0,0,0,16"
                CornerRadius="6"
                Background="#95A0B6">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <!-- Changed "\" to "/" for clarity/safety -->
                <TextBlock Text="CUSTOMER / ENVIRONMENT"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"/>

                <ComboBox ItemsSource="{Binding Customers}"
                          DisplayMemberPath="Customer"
                          SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                          Width="320"
                          FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- LEFT PANEL (Run controls) -->
        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Width="300">

            <TextBlock TextWrapping="Wrap"
                       FontSize="13"
                       Margin="0,0,0,12">
                Choose the customer above that you would like to work with.
                Then choose the APP you would like to run. Outbound has two
                options: ALL tables or a specific table.
            </TextBlock>

            <TextBlock Text="DIRECTION"
                       FontWeight="Bold"
                       Margin="0,0,0,4"/>

            <ComboBox ItemsSource="{Binding Directions}"
                      SelectedItem="{Binding SelectedDirection, Mode=TwoWay}"
                      Width="280"
                      Margin="0,0,0,12"/>

            <TextBlock Text="TABLE / GROUP"
                       FontWeight="Bold"
                       Margin="0,12,0,4"/>

            <!-- Inbound = ALL -->
            <TextBlock Text="ALL"
                       FontSize="14"
                       FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedDirection}" Value="Inbound">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Outbound table selector -->
            <ComboBox ItemsSource="{Binding TableOptions}"
                      SelectedItem="{Binding SelectedTableOption, Mode=TwoWay}"
                      Width="280"
                      Margin="0,4,0,0">
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedDirection}" Value="Outbound">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <TextBlock Text="SEND TO CIS"
                       FontWeight="Bold"
                       Margin="0,12,0,4"/>

            <CheckBox Content="Yes"
                      IsChecked="{Binding SendToCis, Mode=TwoWay}"
                      FontSize="14"/>

            <Button Content="Run"
                    Command="{Binding RunCommand}"
                    Width="120"
                    Margin="0,16,0,0"/>
        </StackPanel>

        <!-- RIGHT PANEL (Tabs) -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="16,0,0,0"
                Padding="12"
                CornerRadius="6"
                Background="#95A0B6">

            <TabControl>

                <!-- TAB 1: Daily Schedule -->
                <TabItem Header="Admin - Daily Schedule">
                    <views:DailyScheduleView />
                </TabItem>

                <!-- TAB 2: API List -->
                <TabItem Header="Admin - API List">
                    <views:ApiListView />
                </TabItem>
                <TabItem Header="Admin - API Tester">
                    <views:ApiTesterView />
                </TabItem>

                <TabItem Header="Admin - Customer Info">
                    <views:CustomerInfoView />
                </TabItem>

            </TabControl>
        </Border>

    </Grid>
</Window>