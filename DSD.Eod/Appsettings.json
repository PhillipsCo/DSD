            {
                "Name": "Delete old rows from [CISOUT_ORDEDETA]",
                "Enabled": true,
                "Order": 10,
                "CommandTimeoutSeconds": 120,
                "Sql": "DELETE FROM [CISOUT_ORDEDETA] WHERE [CreatedDate] < DATEADD(day, -CAST(@RetentionDays as int), SYSDATETIMEOFFSET() AT TIME ZONE 'Pacific Standard Time');",
                "Parameters": {
                    "RetentionDays": 12
                },
                "PassMessage": "PASS: [CISOUT_ORDEDETA] delete succeeded (RetentionDays=@RetentionDays)",
                "FailMessage": "FAIL: [CISOUT_ORDEDETA] delete failed (RetentionDays=@RetentionDays)"
            },
